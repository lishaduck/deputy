{
  "name": "@eslint-deputy/html",
  "version": "0.1.0",
  "description": "Deputy domain for HTML",
  "keywords": [
    "eslint",
    "eslint-deputy",
    "deputy-domain",
    "html"
  ],
  "author": {
    "name": "Eli"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "typecheck": "tsc",
    "typegen": "scripts/typegen.ts"
  },
  "dependencies": {
    "@eslint-deputy/define-config": "workspace:*",
    "@html-eslint/eslint-plugin": "catalog:plugins"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:dev",
    "@eslint-deputy/config": "workspace:*",
    "@eslint-deputy/tsconfig": "workspace:*",
    "@eslint-deputy/typegen": "workspace:*",
    "@types/node": "catalog:types",
    "eslint": "catalog:dev",
    "jiti": "catalog:dev",
    "publint": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "unplugin-unused": "catalog:dev"
  },
  "peerDependencies": {
    "@eslint-deputy/config": "workspace:*",
    "eslint": "catalog:peers"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
