{
  "name": "@eslint-deputy/svelte",
  "version": "0.1.0",
  "description": "Deputy domain for Svelte",
  "keywords": [
    "eslint",
    "eslint-deputy",
    "deputy-domain",
    "svelte",
    "sveltejs"
  ],
  "author": {
    "name": "Eli"
  },
  "sideEffects": false,
  "type": "module",
  "files": [
    "dist/"
  ],
  "scripts": {
    "typecheck": "tsc",
    "typegen": "scripts/typegen.ts"
  },
  "dependencies": {
    "@typescript-eslint/parser": "catalog:parsers",
    "eslint-plugin-svelte": "catalog:plugins",
    "svelte-eslint-parser": "catalog:parsers"
  },
  "devDependencies": {
    "@eslint-deputy/config": "workspace:*",
    "@eslint-deputy/tsconfig": "workspace:*",
    "@eslint-deputy/typegen": "workspace:*",
    "@types/node": "catalog:types",
    "eslint": "catalog:dev",
    "svelte": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@eslint-deputy/config": "workspace:*",
    "eslint": "catalog:peers",
    "svelte": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.18.0 || ^22.11.0 || >=24.0.0"
  }
}
