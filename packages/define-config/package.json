{
  "name": "@eslint-deputy/define-config",
  "version": "0.1.0",
  "description": "@eslint/config-helpers, but typed",
  "keywords": [
    "eslint"
  ],
  "author": {
    "name": "Eli"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "typecheck": "tsc"
  },
  "dependencies": {
    "@eslint/config-helpers": "catalog:"
  },
  "devDependencies": {
    "@eslint-deputy/tsconfig": "workspace:*",
    "@types/node": "catalog:types",
    "eslint": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "eslint": "catalog:peers"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
