{
  "name": "@eslint-deputy/turbo",
  "version": "0.1.0",
  "description": "Deputy domain for Turborepo",
  "keywords": [
    "eslint",
    "eslint-deputy",
    "deputy-domain",
    "turbo",
    "turborepo"
  ],
  "author": {
    "name": "Eli"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "typegen": "./scripts/typegen.ts"
  },
  "dependencies": {
    "@eslint-deputy/define-config": "workspace:*",
    "eslint-plugin-turbo": "catalog:plugins"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:dev",
    "@eslint-deputy/config": "workspace:*",
    "@eslint-deputy/tsconfig": "workspace:*",
    "@eslint-deputy/tsdown-config": "workspace:*",
    "@eslint-deputy/typegen": "workspace:*",
    "@types/node": "catalog:types",
    "eslint": "catalog:dev",
    "publint": "catalog:dev",
    "tsdown": "catalog:dev",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev",
    "unplugin-unused": "catalog:dev"
  },
  "peerDependencies": {
    "@eslint-deputy/config": "workspace:*",
    "eslint": "catalog:peers",
    "turbo": "catalog:peers"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
