{
  "name": "@eslint-deputy/pnpm",
  "version": "0.1.0",
  "description": "Deputy domain for pnpm",
  "keywords": [
    "eslint",
    "eslint-deputy",
    "deputy-domain",
    "pnpm"
  ],
  "author": {
    "name": "Eli"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "typecheck": "tsc",
    "typegen": "scripts/typegen.ts"
  },
  "dependencies": {
    "eslint-plugin-pnpm": "catalog:plugins"
  },
  "devDependencies": {
    "@eslint-deputy/config": "workspace:*",
    "@eslint-deputy/tsconfig": "workspace:*",
    "@eslint-deputy/typegen": "workspace:*",
    "@types/node": "catalog:types",
    "eslint": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@eslint-deputy/config": "workspace:*",
    "eslint": "catalog:peers"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
