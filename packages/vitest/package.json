{
  "name": "@eslint-deputy/vitest",
  "version": "0.1.0",
  "description": "Deputy domain for Vitest",
  "keywords": [
    "eslint",
    "eslint-deputy",
    "deputy-domain",
    "vitest"
  ],
  "author": {
    "name": "Eli"
  },
  "sideEffects": false,
  "type": "module",
  "files": [
    "dist/"
  ],
  "scripts": {
    "typegen": "scripts/typegen.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@vitest/eslint-plugin": "catalog:plugins"
  },
  "devDependencies": {
