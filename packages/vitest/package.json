    "eslint": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@eslint-deputy/config": "workspace:*",
    "eslint": "catalog:peers"
  },
  "engines": {
    "node": "^20.18.0 || ^22.11.0 || >=24.0.0"
