{
  "name": "@eslint-deputy/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Our monorepo root.",
  "license": "UPL-1.0",
  "type": "module",
  "scripts": {
    "check-deduped-deps": "pnpm dedupe --check --prefer-offline",
    "dev": "eslint-config-inspector",
    "format": "prettier . --write --experimental-cli",
    "format:check": "prettier . --check --experimental-cli",
    "inspect-nm": "node-modules-inspector",
    "knip": "turbo run knip:dev knip:prod --continue",
    "knip:dev": "knip",
    "knip:prod": "knip --production --strict --exclude types",
    "lint": "eslint --flag=v10_config_lookup_from_file",
    "manypkg": "manypkg check",
    "merge-checks": "turbo run typecheck knip:dev knip:prod lint format:check manypkg typesync:check ts-references:check --continue=dependencies-successful",
    "prepare": "turbo run typegen build",
    "ts-references:check": "update-ts-references --check",
    "ts-references:update": "update-ts-references",
    "typecheck": "tsc -b",
    "typesync": "typesync",
    "typesync:check": "typesync --dry=fail"
  },
  "devDependencies": {
    "@eslint-deputy/internal-config": "workspace:*",
    "@eslint-deputy/tsconfig": "workspace:*",
    "@eslint/config-inspector": "catalog:dev",
    "@manypkg/cli": "catalog:dev",
    "@prettier/plugin-oxc": "catalog:dev",
    "@types/node": "catalog:types",
    "eslint": "catalog:dev",
    "jiti": "catalog:dev",
    "knip": "catalog:dev",
    "node-modules-inspector": "catalog:dev",
    "prettier": "catalog:dev",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev",
    "typesync": "catalog:dev",
    "update-ts-references": "catalog:dev"
  },
  "packageManager": "pnpm@10.17.0+sha512.fce8a3dd29a4ed2ec566fb53efbb04d8c44a0f05bc6f24a73046910fb9c3ce7afa35a0980500668fa3573345bd644644fa98338fa168235c80f4aa17aa17fbef",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": "^20.19.0 || ^22.12.0 || >=24.0.0"
    },
    "packageManager": {
      "name": "pnpm",
      "onFail": "error"
    }
  }
}
